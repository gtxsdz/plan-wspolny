{
  "rules": {
    "schedule": {
      ".read": true,
      ".write": "auth != null && root.child('admins').child(auth.uid).exists()",
      "days": {
        "$day": {
          ".validate": "newData.hasChild('lessons')",
          "lessons": {
            "$slot": {
              "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
              "room": { ".validate": "newData.isString() && newData.val().length <= 24" },
              "icon": { ".validate": "newData.isString() && newData.val().length <= 8" },
              "empty": { ".validate": "newData.isBoolean()" }
            }
          }
        }
      },
      "updatedAt": { ".validate": "newData.isNumber()" },
      "updatedBy": { ".validate": "newData.isString() && newData.val().length <= 64" }
    },
    "admins": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid"
      }
    }
  }
}
